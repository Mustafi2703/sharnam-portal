# =============================================================================
# Hostinger Web App — portal.spdc.in
# =============================================================================
# Copy to hPanel → portal.spdc.in → Environment variables (one KEY per row).
# Or locally:  cp .env.hostinger.example .env  then  bash scripts/export-hostinger-env.sh
#
# DO NOT commit a filled .env (secrets). This file is the template only.
#
# ── Deploy / seed (read before every deploy) ─────────────────────────────────
#
# FIRST deploy (empty MySQL):
#   RUN_SEED=1
#   (omit SKIP_BUILD_SEED)
#
# ALL LATER deploys (demo tomorrow, CRM + HRMS data must stay):
#   SKIP_BUILD_SEED=1
#   (remove RUN_SEED entirely — do NOT set RUN_SEED=0, just delete the line)
#
# Without SKIP_BUILD_SEED, each build runs demoScreenshotsPack + arvind week refresh
# (slower build, can touch demo rows). For go-live demo use SKIP_BUILD_SEED=1.
#
# ── Never set on Hostinger ───────────────────────────────────────────────────
# PORT          — Hostinger injects automatically
# DATABASE_URL=file:... — SQLite not supported; use MYSQL_* below OR Connect database
# =============================================================================

NODE_ENV=production

# Generate once: openssl rand -base64 48
JWT_SECRET=CHANGE-ME-generate-with-openssl-rand-base64-48

WEB_ORIGIN=https://portal.spdc.in
UPLOAD_DIR=./data/uploads

# ── MySQL (hPanel → Databases) ───────────────────────────────────────────────
# Option A: Fill these four (recommended — avoids URL-encoding issues)
MYSQL_USER=u252873650_sharnam_qryx
MYSQL_PASSWORD=YOUR_MYSQL_PASSWORD_FROM_HPANEL
MYSQL_DATABASE=u252873650_sharnam_portal
MYSQL_HOST=127.0.0.1

# Option B: If you used hPanel "Connect a database", Hostinger may inject DATABASE_URL
# instead. Do not set both conflicting URLs — MYSQL_* takes priority when all four are set.

# ── Seed control (critical for demo day) ─────────────────────────────────────
SKIP_BUILD_SEED=1
# RUN_SEED=1
SEED_PASSWORD=Demo@1234
SHARNAM_EXCEL_ROOT=./seed/data

# ── Microsoft 365 · SharePoint (live DMS + proposals) ──────────────────────
# App registration: Sharnam Portal — see docs/M365_SETUP.md
MOCK_ONEDRIVE=false
AZURE_TENANT_ID=YOUR_ENTRA_TENANT_ID
AZURE_CLIENT_ID=2fd78789-594e-4af6-b43d-cb82f59df39c
AZURE_CLIENT_SECRET=YOUR_AZURE_CLIENT_SECRET
SHAREPOINT_SITE_URL=https://spdcsmb.sharepoint.com/sites/SharnamProjects

# Aliases also accepted: GRAPH_TENANT_ID / GRAPH_CLIENT_ID / GRAPH_CLIENT_SECRET

# ── Outlook mail (RFI / notifications) ───────────────────────────────────────
GRAPH_MAIL_FROM=pmc-portal@spdc.in
GRAPH_MAIL_ENABLED=true
# Keep false until you intentionally send mail to real client/vendor inboxes
PORTAL_MAIL_LIVE=false

# ── Optional: WhatsApp (MSG91 India) ───────────────────────────────────────
# WHATSAPP_PROVIDER=msg91
# MSG91_AUTH_KEY=
# MSG91_WHATSAPP_SENDER=
# MSG91_INTEGRATED_NUMBER=
# MSG91_WHATSAPP_TEMPLATE_ID=

# ── Optional: Twilio WhatsApp ────────────────────────────────────────────────
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ── Demo logins (after first RUN_SEED=1 build) ───────────────────────────────
# Office CRM / HRMS desk : office@sharnam.demo / Demo@1234
# Site punch             : site@sharnam.demo   / Demo@1234
# HRMS candidate flow    : riya.shah@sharnam.demo / Demo@1234
#
# CRM flow (fast until Launch): Leads → Proposals → Award → Project setup → Launch (folders ~1 min)
# HRMS flow: Recruitment → offer → join → letters (riya.shah@sharnam.demo)
