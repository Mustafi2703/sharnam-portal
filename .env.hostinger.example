# Copy to .env on Hostinger VPS:  cp .env.hostinger.example .env

# --- Server ---
NODE_ENV=production
PORT=4000
HOST=127.0.0.1

# Persistent paths (create these directories)
DATABASE_URL=file:./data/prod.db
UPLOAD_DIR=./data/uploads
JWT_SECRET=CHANGE-ME-long-random-string

# Your public URL (no trailing slash) — used for CORS + links
WEB_ORIGIN=https://portal.yourdomain.com
VITE_API_URL=

# Demo passwords for seeded users (change before go-live)
SEED_PASSWORD=Demo@1234

# First deploy only: RUN_SEED=1 bash scripts/start-production.sh
# After that, always set:
SKIP_SEED=1

# Excel seed data (bundled in repo)
SHARNAM_EXCEL_ROOT=./seed/data

# --- Microsoft 365 (live SharePoint + mail on SPDC tenant) ---
MOCK_ONEDRIVE=false
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
SHAREPOINT_SITE_URL=https://spdcsmb.sharepoint.com/sites/SharnamProjects
GRAPH_MAIL_FROM=pmc-portal@spdc.in
GRAPH_MAIL_ENABLED=true

# MS Project S-curve (optional — skip if not licensed)
MS_PROJECT_ENABLED=false
