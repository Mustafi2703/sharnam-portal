# Hostinger portal.spdc.in — copy to .env and fill MYSQL_PASSWORD, then import in hPanel
# Do NOT set PORT. Do NOT set DATABASE_URL=file:... (use MYSQL_* below).

NODE_ENV=production
JWT_SECRET=CHANGE-ME-long-random-string
WEB_ORIGIN=https://portal.spdc.in
UPLOAD_DIR=./data/uploads

MYSQL_USER=u252873650_sharnam_qryx
MYSQL_PASSWORD=YOUR_MYSQL_PASSWORD
MYSQL_DATABASE=u252873650_sharnam_portal
MYSQL_HOST=127.0.0.1

RUN_SEED=1
# First deploy only — full seed via seed.ts (includes demo screenshot pack). Remove RUN_SEED=1 after login works.
# SKIP_BUILD_SEED=1 — set on later deploys to skip all DB seed during build (fast redeploy; data already in MySQL).
SEED_PASSWORD=Demo@1234
SHARNAM_EXCEL_ROOT=./seed/data

MOCK_ONEDRIVE=false
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
SHAREPOINT_SITE_URL=https://spdcsmb.sharepoint.com/sites/SharnamProjects
GRAPH_MAIL_FROM=pmc-portal@spdc.in
GRAPH_MAIL_ENABLED=true
