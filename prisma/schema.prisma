  projectId        String
  srNo             Int
  isoArea          String
  folder           String
  isoClause        String?
  name             String
  custodian        String    @default("HO")
  relativePath     String?
  workbookFileName String?
  recordsCount     Int       @default(0)
  openCount        Int       @default(0)
  closedCount      Int       @default(0)
  overdueCount     Int       @default(0)
  pctClosed        Float?
  oldestOpenDays   Int?
  kraScore         Float?
  rag              String    @default("UNUSED")
  lastRefreshedAt  DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, srNo])
}

/**
 * Role KRA scorecard (06_ROLE_KRA)
 */
model KpiRoleKra {
  id           String   @id @default(cuid())
  projectId    String
  roleKey      String
  kraNo        String?
  description  String?  @db.Text
  consequence  String?  @db.Text
  evidenceHint String?
  kpiCode      String?
  target       String?
  subjectCount Int?
  redCount     Int      @default(0)
  amberCount   Int      @default(0)
  greenCount   Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

/**
 * Project closure report — editable sections + uploaded docx pack
 */
model ProjectClosureReport {
  id           String    @id @default(cuid())
  projectId    String    @unique
  title        String?
  status       String    @default("Draft")
  summary      String?   @db.Text
  sectionsJson String?   @db.Text
  fileUrl      String?
  fileName     String?
  approvedAt   DateTime?
  updatedById  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}
