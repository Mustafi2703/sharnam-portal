/**
 * Manpower Requisition — a dept opens it; HR approves before we post the job.
 */
model ManpowerRequisition {
  id               String    @id @default(cuid())
  requisitionNo    String    @unique
  department       String
  designation      String
  count            Int       @default(1)
  employmentType   String    @default("Permanent")
  reportingManager String?
  justification    String?
  urgency          String?   @default("Normal")
  ctcRangeMin      Float?
  ctcRangeMax      Float?
  location         String?
  requestedById    String
  approvedById     String?
  approvedAt       DateTime?
  /// Draft | Submitted | Approved | Rejected | Closed
  status           String    @default("Submitted")
  rejectionReason  String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @default(now()) @updatedAt

  postings JobPosting[]
}

/**
 * Job Posting — sourcing channels (LinkedIn / Naukri / Website / Referral).
 */
model JobPosting {
  id             String    @id @default(cuid())
  requisitionId  String?
  title          String
  department     String?
  location       String?
  employmentType String?   @default("Permanent")
  description    String?
  requirements   String?
  channelsJson   String?   @default("[]") @db.Text
  postedAt       DateTime?
  closedAt       DateTime?
  /// Open | Closed | On-Hold
  status         String    @default("Open")
  postedById     String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt

  requisition ManpowerRequisition? @relation(fields: [requisitionId], references: [id])
  candidates  Candidate[]
}

/**
 * Candidate — resume database. Moves through stages until Offered/Joined.
 */
model Candidate {
  id               String   @id @default(cuid())
  postingId        String?
  fullName         String
  email            String?
  phone            String?
  sourceChannel    String?
  resumeUrl        String?
  currentCompany   String?
  currentDesign    String?
  currentCtc       Float?
  expectedCtc      Float?
  noticePeriodDays Int?
  experienceYears  Float?
  skills           String?
  location         String?
  /// New | Screened | Shortlisted | Interview | Selected | Offered | Joined | Rejected | Withdrawn
  status           String   @default("New")
  screenedById     String?
  rejectionReason  String?
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt

  posting    JobPosting?      @relation(fields: [postingId], references: [id])
  interviews InterviewRound[]
  offers     Offer[]
}

/**
 * Interview Round — technical / HR / management.
 * Meeting link (Teams / Zoom / in-person) + panel + scorecard.
 */
model InterviewRound {
  id                 String    @id @default(cuid())
  candidateId        String
  roundNumber        Int       @default(1)
  roundType          String
  panelJson          String?   @default("[]") @db.Text
  scheduledAt        DateTime?
  durationMins       Int?      @default(60)
  mode               String    @default("Teams")
  meetingLink        String?
  meetingId          String?
  feedbackTechnical  String?
  feedbackHr         String?
  feedbackMgmt       String?
  scoreTechnical     Float?
  scoreCommunication Float?
  scoreCulture       Float?
  scoreOverall       Float?
  /// Scheduled | Completed | No-Show | Cancelled
  status             String    @default("Scheduled")
  /// Advance | Reject | Hold
  decision           String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @default(now()) @updatedAt

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
}

/**
 * Offer letter — CTC breakdown, joining date, approval workflow.
 */
model Offer {
  id                String    @id @default(cuid())
  candidateId       String
  offerNo           String    @unique
  designation       String
  department        String?
  ctcAnnual         Float
  basicMonthly      Float?
  hraMonthly        Float?
  otherAllowMonthly Float?
  variablePayPct    Float?
  joiningDate       DateTime?
  probationMonths   Int?      @default(6)
  location          String?
  reportingManager  String?
  offerLetterUrl    String?
  /// 12-input CTC calculator payload (see services/ctcAnnexure.ts) so
  /// Annexure I can be regenerated on demand without re-entering values.
  ctcInputsJson     String?   @db.Text
  /// URL of the generated Annexure I XLSX (Sharnam-branded, editable).
  annexureUrl       String?
  approvedById      String?
  approvedAt        DateTime?
  sentAt            DateTime?
  acceptedAt        DateTime?
  declinedAt        DateTime?
  joinedAt          DateTime?
  /// Draft | Approved | Sent | Accepted | Declined | Withdrawn | Joined
  status            String    @default("Draft")
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @default(now()) @updatedAt

  candidate Candidate            @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  preJoin   PreJoiningChecklist?
  onboard   OnboardingChecklist?
}

/**
 * Pre-Joining Checklist — document collection, BGV, medical, IT asset, ID card, welcome kit.
 */
model PreJoiningChecklist {
  id                   String    @id @default(cuid())
  offerId              String    @unique
  empCodeGenerated     String?
  appointmentLetterUrl String?
  docCollectionDone    Boolean   @default(false)
  docCollectionAt      DateTime?
  bgvStatus            String    @default("Pending")
  bgvAt                DateTime?
  medicalStatus        String    @default("Pending")
  medicalAt            DateTime?
  itAssetRequested     Boolean   @default(false)
  itAssetIssuedAt      DateTime?
  itAssetDetails       String?
  emailCreated         Boolean   @default(false)
  emailCreatedAt       DateTime?
  emailAddress         String?
  idCardRequested      Boolean   @default(false)
  idCardIssuedAt       DateTime?
  welcomeKitPrepared   Boolean   @default(false)
  welcomeKitAt         DateTime?
  notes                String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @default(now()) @updatedAt

  offer Offer @relation(fields: [offerId], references: [id], onDelete: Cascade)
}

/**
 * Onboarding Checklist — joining formalities, personal info, doc verification, HR policy ack.
 * Stateful list of every item + who / when it was ticked.
 */
model OnboardingChecklist {
  id                       String   @id @default(cuid())
  offerId                  String   @unique
  userId                   String?
  joiningFormalitiesDone   Boolean  @default(false)
  personalInfoDone         Boolean  @default(false)
  bankDetailsDone          Boolean  @default(false)
  panAadhaarDone           Boolean  @default(false)
  pfEsicDone               Boolean  @default(false)
  nomineeDone              Boolean  @default(false)
  docVerificationDone      Boolean  @default(false)
  departmentAllocated      Boolean  @default(false)
  reportingManagerAssigned Boolean  @default(false)
  orientationDone          Boolean  @default(false)
  hrPolicyAcknowledged     Boolean  @default(false)
  itemsCompletedAtJson     String   @default("{}") @db.Text
  notes                    String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @default(now()) @updatedAt

  offer Offer @relation(fields: [offerId], references: [id], onDelete: Cascade)
}

/**
 * Pay Hike — salary revision with old/new snapshot, reason, approval.
 */
model PayHike {
  id                String    @id @default(cuid())
  userId            String
  effectiveDate     DateTime
  oldCtcAnnual      Float
  newCtcAnnual      Float
  hikePercent       Float
  oldBasicMonthly   Float?
  newBasicMonthly   Float?
  oldHraMonthly     Float?
  newHraMonthly     Float?
  reason            String?
  performanceRating String?
  approvedById      String?
  approvedAt        DateTime?
  /// Draft | Submitted | Approved | Rejected | Applied
  status            String    @default("Submitted")
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @default(now()) @updatedAt
}

/**
 * Payslip — one row per user per month. Auto-generated from EmployeeProfile + adjustments.
 */
model Payslip {
  id              String   @id @default(cuid())
  userId          String
  year            Int
  month           Int
  workingDays     Float    @default(0)
  paidDays        Float    @default(0)
  lopDays         Float    @default(0)
  basic           Float    @default(0)
  hra             Float    @default(0)
  conveyance      Float    @default(0)
  medicalAllow    Float    @default(0)
  specialAllow    Float    @default(0)
  otherEarnings   Float    @default(0)
  grossEarnings   Float    @default(0)
  pfEmployee      Float    @default(0)
  esicEmployee    Float    @default(0)
  professionalTax Float    @default(0)
  incomeTax       Float    @default(0)
  otherDeduction  Float    @default(0)
  totalDeductions Float    @default(0)
  netPay          Float    @default(0)
  status          String   @default("Generated")
  generatedAt     DateTime @default(now())
  generatedById   String?
  fileUrl         String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt

  @@unique([userId, year, month])
}

model CustomSheet {
  id          String   @id @default(cuid())
  projectId   String?
  name        String
  category    String?
  headersJson String   @db.Text
  rowsJson    String   @db.Text
  sourceFile  String?
  storagePath String?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/**
 * DPR snapshot — one row per (project × logDate × discipline).
 * Persists the DPR maker's header + BOQ line inputs so the same DPR
 * can be re-opened, edited, and re-published without losing state.
 * headerJson: {
 * projectManager, contractor, location, contractRef, contractCompletion,
 * calendarHours, shiftHours, weather, reportDate, dataDate, reportNumber,
 * acCertifiedToDate, cumManDaysPrev, cumSafeManHoursPrev, dateOfLastLti
 * }
 * linesJson: [
 * { group, description, unit, scopeQty, rate, start, finish,
 * cumQtyPrev, qtyToday, remarks }
 * ]
 * Discipline: CIVIL | ELECTRICAL | FIRE | MECHANICAL | PEB_ERECTION |
 * PEB_SUPPLY | PLUMBING
 */
model DprSnapshot {
  id            String    @id @default(cuid())
  projectId     String
  logDate       DateTime
  discipline    String    @default("CIVIL")
  headerJson    String    @default("{}") @db.Text
  linesJson     String    @default("[]") @db.Text
  status        String    @default("Draft")
  publishedAt   DateTime?
  publishedPath String?
  createdById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt

  @@unique([projectId, logDate, discipline])
  @@index([projectId, logDate])
}

/**
 * WPR snapshot — one row per (project × weekEnding).
 * Persists the multi-section WPR maker's editable content so it can be
 * re-opened and re-published.
 * sectionsJson: {
 * brief, stakeholders, mobilisation, communicationMatrix,
 * projectDashboard, criticalAreas, capex, prTracker, hindrance, risk,
 * legal, drawingRegister, designStatus, procurement, milestones,
 * manpowerHistogram, weeklyExecuted, cashflow, quality, safety,
 * plannedVsActual, materialStock, progressPictures
 * }  (each is { title, notes, tableRows[], imagePaths[] })
 */
model WprSnapshot {
  id            String    @id @default(cuid())
  projectId     String
  weekEnding    DateTime
  reportNumber  Int?
  sectionsJson  String    @default("{}") @db.Text
  status        String    @default("Draft")
  publishedAt   DateTime?
  publishedPath String?
  createdById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt

  @@unique([projectId, weekEnding])
  @@index([projectId, weekEnding])
}

// —— Procore-style directory, RFI, QA ——

model Vendor {
  id                 String   @id @default(cuid())
  name               String
  /// Contractor | Vendor | Client | Consultant | PMC
  partyType          String   @default("Vendor")
  trade              String?
  address            String?
  city               String?
  state              String?
  country            String?  @default("India")
  businessPhone      String?
  email              String?
  website            String?
  primaryContactName String?
  licenseNumber      String?
  gstNumber          String?
  isUnionMember      Boolean  @default(false)
  isPrequalified     Boolean  @default(false)
  isMinorityOwned    Boolean  @default(false)
  isWomenOwned       Boolean  @default(false)
  insuranceVerified  Boolean  @default(false)
  notes              String?
  createdVia         String   @default("Manual")
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @default(now()) @updatedAt

  projects       ProjectVendor[]
  rfis           Rfi[]
  bills          VendorBill[]
  purchaseOrders PurchaseOrder[]
  raBills        RaBill[]
  crmVendorBoqs  CrmVendorBoq[]
}

/**
 * CRM bid package — vendor BOQ collection + comparative analysis (office only).
 */
model CrmBidPackage {
  id                       String    @id @default(cuid())
  leadId                   String?
  projectId                String?
  title                    String
  status                   String    @default("Open")
  revisionLabel            String    @default("R2")
  vendorNamesJson          String    @default("[]") @db.Text
  /// Selected discipline BOQ sheets for this package (JSON array of {key,label,sheetName})
  disciplinesJson          String?   @db.Text
  dueDate                  DateTime?
  notes                    String?
  comparativeSheetId       String?
  summarySheetId           String?
  comparativeSharePointUrl String?
  awardedVendorId          String?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  lead       Lead?          @relation(fields: [leadId], references: [id], onDelete: SetNull)
  project    Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  vendorBoqs CrmVendorBoq[]
}

/**
 * Vendor BOQ upload — one slot per vendor × discipline (R2 pattern).
 */
model CrmVendorBoq {
  id            String    @id @default(cuid())
  bidPackageId  String
  vendorId      String?
  vendorLabel   String
  discipline    String
  fileName      String?
  storagePath   String?
  sharePointUrl String?
  sheetId       String?
  uploadedById  String?
  uploadedAt    DateTime?

  bidPackage CrmBidPackage @relation(fields: [bidPackageId], references: [id], onDelete: Cascade)
  vendor     Vendor?       @relation(fields: [vendorId], references: [id], onDelete: SetNull)

  @@unique([bidPackageId, vendorLabel, discipline])
}

model ProjectVendor {
  id          String   @id @default(cuid())
  projectId   String
  vendorId    String
  tradeRole   String?
  assignedVia String   @default("Manual")
  createdAt   DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  vendor  Vendor  @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([projectId, vendorId])
}

model Rfi {
  id                    String    @id @default(cuid())
  projectId             String
  number                String
  subject               String
  question              String
  /// RequestForInformation | DrawingChecklist | QualityInspection | QualityIR | SafetyIR | ActivityInspection | SafetyChecklist | Manual | ClientConcern
  rfiKind               String    @default("RequestForInformation")
  /// SPDC IR / HSE / checklist reference number (IR/CIV/024, HSE/IR/012, CL/CIV/104)
  irNumber              String?
  /// Structured SPDC form fields (particulars, drawing ref text, clearance codes, etc.)
  formDataJson          String?   @db.Text
  status                String    @default("Open")
  ballInCourt           String    @default("Assignee")
  assignedToId          String?
  createdById           String
  dueDate               DateTime?
  closedAt              DateTime?
  linkedDrawingId       String?
  drawingPinJson        String?   @db.Text
  /// Legacy: often stores checklist template id
  linkedChecklistItemId String?
  /// Checklist assignment to be filled by matrix parties / vendor
  linkedAssignmentId    String?
  specSectionLink       String?
  responsibleVendorId   String?
  questionReceivedFrom  String?
  distributionJson      String?   @db.Text
  scheduleImpact        String?   @default("None")
  costImpact            String?   @default("None")
  isPrivate             Boolean   @default(false)
  attachmentsJson       String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  project    Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignedTo User?         @relation("RfiAssignee", fields: [assignedToId], references: [id])
  createdBy  User          @relation("RfiCreator", fields: [createdById], references: [id])
  drawing    Drawing?      @relation(fields: [linkedDrawingId], references: [id])
  vendor     Vendor?       @relation(fields: [responsibleVendorId], references: [id])
  responses  RfiResponse[]

  @@unique([projectId, number])
}

model RfiResponse {
  id                 String   @id @default(cuid())
  rfiId              String
  respondedById      String
  responseChannel    String   @default("Web")
  responseText       String
  isOfficialResponse Boolean  @default(false)
  createdAt          DateTime @default(now())

  rfi         Rfi  @relation(fields: [rfiId], references: [id], onDelete: Cascade)
  respondedBy User @relation(fields: [respondedById], references: [id])
}

model QualityInspection {
  id                  String    @id @default(cuid())
  projectId           String
  title               String
  inspectionType      String    @default("Quality")
  /// Draft → Ready → In Progress → Closed
  status              String    @default("Draft")
  location            String?
  linkedDrawingId     String?
  /// Checklist template that seeded the form items
  checklistTemplateId String?
  trade               String?
  createdById         String
  assignedToId        String?
  dueDate             DateTime?
  completedAt         DateTime?
  attachmentsJson     String?   @db.Text
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  project    Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  drawing    Drawing?         @relation(fields: [linkedDrawingId], references: [id])
  createdBy  User             @relation("InspectionCreator", fields: [createdById], references: [id])
  assignedTo User?            @relation("InspectionAssignee", fields: [assignedToId], references: [id])
  items      InspectionItem[]
}

model InspectionItem {
  id              String    @id @default(cuid())
  inspectionId    String
  description     String
  status          String    @default("Pending")
  remarks         String?
  /// JSON array of { url, name, kind, comment? }
  attachmentsJson String?   @db.Text
  sortOrder       Int       @default(0)
  dueDate         DateTime?
  autoGenerateRfi Boolean   @default(false)
  linkedRfiId     String?

  inspection QualityInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
