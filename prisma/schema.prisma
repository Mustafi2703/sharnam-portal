  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

/**
 * Purchase Order — contract / WO to a vendor. Anchors RA bills, invoices and COPs.
 * Mirrors columns from Payment Summary (WO/PO no & date, original value, amendments).
 */
model PurchaseOrder {
  id                    String    @id @default(cuid())
  projectId             String
  poNumber              String
  poDate                DateTime?
  vendorId              String?
  vendorName            String
  workTrade             String?
  packageName           String?
  budgetCode            String?
  originalValue         Float     @default(0)
  amendmentNo           String?
  amendedValue          Float     @default(0)
  retentionPct          Float     @default(5)
  advancePct            Float     @default(0)
  advanceAdjustedAmt    Float     @default(0)
  totalBilledWithoutGst Float     @default(0)
  totalBilledWithGst    Float     @default(0)
  totalCertified        Float     @default(0)
  totalPaid             Float     @default(0)
  status                String    @default("Active")
  attachmentUrl         String?
  panNumber             String?
  gstNumber             String?
  payableTo             String?
  createdById           String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  project      Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  vendor       Vendor?                @relation(fields: [vendorId], references: [id])
  raBills      RaBill[]
  certificates CertificateOfPayment[]

  @@unique([projectId, poNumber])
}

/**
 * RA Bill (Running Account bill) — vendor invoice against a PO.
 * Mirrors Payment Summary "CIVIL RA Bill" columns: invoice, price variation, GST,
 * advance adjusted, retention, net payable, cumulative.
 */
model RaBill {
  id                     String    @id @default(cuid())
  projectId              String
  purchaseOrderId        String?
  raNumber               String
  invoiceNumber          String?
  invoiceDate            DateTime?
  description            String?
  againstBillRaised      Float     @default(0)
  priceVariation         Float     @default(0)
  totalInvoiceWithoutGst Float     @default(0)
  gstAmount              Float     @default(0)
  totalInvoiceWithGst    Float     @default(0)
  advanceAdjusted        Float     @default(0)
  retentionAmount        Float     @default(0)
  otherRecoveries        Float     @default(0)
  netAmountPayable       Float     @default(0)
  previousBillTotal      Float     @default(0)
  cumulativeBillTotal    Float     @default(0)
  /// Draft | Submitted | Under Review | Certified | Paid | Rejected
  status                 String    @default("Submitted")
  discipline             String?
  vendorId               String?
  vendorName             String?
  copNo                  String?
  attachmentUrl          String?
  createdById            String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  project       Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  vendor        Vendor?                @relation(fields: [vendorId], references: [id])
  purchaseOrder PurchaseOrder?         @relation(fields: [purchaseOrderId], references: [id])
  certificates  CertificateOfPayment[]

  @@index([projectId, purchaseOrderId])
}

/**
 * Certificate of Payment (COP) — the certified letter that authorises payment
 * against a specific RA bill or material advance. Format matches Viatrix_RA BILL_COP.xlsm.
 */
model CertificateOfPayment {
  id                String    @id @default(cuid())
  projectId         String
  certificateNumber String
  certificateType   String?
  certificateDate   DateTime?
  contractor        String
  workTrade         String?
  budgetCode        String?
  purchaseOrderId   String?
  poNumberDate      String?
  originalWoValue   Float     @default(0)
  amendmentNo       String?
  amendedWoValue    Float     @default(0)
  invoiceNoDate     String?
  raBillId          String?
  amountCertified   Float     @default(0)
  amountPayable     Float     @default(0)
  gstAmount         Float     @default(0)
  retentionAmount   Float     @default(0)
  panNumber         String?
  gstNumber         String?
  payableTo         String?
  remarks           String?
  /// Draft | Certified | Approved | Paid | Rejected
  status            String    @default("Draft")
  attachmentUrl     String?
  createdById       String?
  certifiedById     String?
  approvedById      String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  raBill        RaBill?        @relation(fields: [raBillId], references: [id])

  @@unique([projectId, certificateNumber])
}

/**
 * Quotation — CRM quotation / proposal to a client.
 * Feeds the quotation-maker tool that spits out the SPDC PMC proposal format.
 */
model Quotation {
  id               String    @id @default(cuid())
  projectId        String?
  leadId           String?
  quotationNo      String
  clientName       String
  clientAddress    String?
  clientGst        String?
  scopeSummary     String?
  totalValue       Float     @default(0)
  currency         String    @default("INR")
  /// Draft | Sent | Negotiation | Won | Lost | Awarded
  status           String    @default("Draft")
  validityDays     Int       @default(30)
  quotationDate    DateTime  @default(now())
  awardedAt        DateTime?
  awardedProjectId String?
  sectionsJson     String?
  attachmentUrl    String?
  createdById      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  lead    Lead?    @relation(fields: [leadId], references: [id])
}
