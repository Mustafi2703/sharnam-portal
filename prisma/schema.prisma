generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  fullName     String
  role         String   @default("office")
  portal       String   @default("office")
  phone        String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships          ProjectMember[]
  uploadedDrawings     DrawingRevision[]     @relation("DrawingUploader")
  checklistSubmissions ChecklistSubmission[]
  dailyLogsCreated     DailyLog[]            @relation("DailyLogCreator")
  auditEvents          AuditEvent[]
  meetingItems         MeetingItem[]
  leadsOwned           Lead[]
  attendance           Attendance[]
  leaveRequests        LeaveRequest[]
  rfisCreated          Rfi[]                 @relation("RfiCreator")
  rfisAssigned         Rfi[]                 @relation("RfiAssignee")
  rfiResponses         RfiResponse[]
  inspectionsCreated   QualityInspection[]   @relation("InspectionCreator")
  inspectionsAssigned  QualityInspection[]   @relation("InspectionAssignee")
  safetyReported       SafetyRecord[]        @relation("SafetyReporter")
  safetyAssigned       SafetyRecord[]        @relation("SafetyAssignee")
}

model RoleDefinition {
  id          String   @id @default(cuid())
  key         String   @unique
  label       String
  portal      String
  permissions String
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Project {
  id                      String    @id @default(cuid())
  code                    String    @unique
  name                    String
  clientName              String?
  /// Client / stakeholder card (CRM → project)
  clientContactName       String?
  clientEmail             String?
  clientPhone             String?
  clientAddress           String?
  clientGst               String?
  designConsultant        String?
  contractorName          String?
  location                String?
  status                  String    @default("Planning")
  startDate               DateTime?
  endDate                 DateTime?
  /// Comma-separated notification emails for this project
  notificationEmails      String?
  emailFromName           String?   @default("शरणम् Portal")
  emailEnabled            Boolean   @default(true)
  notifyOnDrawingPublish  Boolean   @default(true)
  notifyOnChecklistSubmit Boolean   @default(true)
  /// Outlook / Microsoft 365 mailbox for project mail (Graph when configured)
  outlookMailbox          String?
  outlookConnected        Boolean   @default(false)
  outlookConnectedAt      DateTime?
  /// JSON array of enabled module keys (drawings, quality, safety, progress, …)
  enabledModules          String    @default("[\"drawings\",\"quality\",\"safety\",\"progress\",\"comms\",\"field\",\"cost\",\"reports\"]")
  /// JSON array of work packages e.g. Civil, PEB, Electrical
  workPackages            String    @default("[\"Civil\",\"PEB\"]")
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  members               ProjectMember[]
  drawings              Drawing[]
  folders               DocumentFolder[]
  checklistAssignments  ChecklistAssignment[]
  dailyLogs             DailyLog[]
  commMatrix            CommunicationMatrix[]
  commLogs              CommunicationLog[]
  meetings              Meeting[]
  budgetLines           CostBudgetLine[]
  monitoringLines       CostMonitoringLine[]
  cashflowPeriods       CostCashflowPeriod[]
  boqBatches            BoqImportBatch[]
  rateDiffs             CostRateDifference[]
  mbLines               CostMbLine[]
  bbsLines              CostBbsLine[]
  leads                 Lead[]
  deals                 Deal[]
  vendors               ProjectVendor[]
  rfis                  Rfi[]
  inspections           QualityInspection[]
  photos                ProjectPhoto[]
  submittals            Submittal[]
  coordinationIssues    DesignCoordinationIssue[]
  safetyRecords         SafetyRecord[]
  emailOutbox           EmailOutbox[]
  vendorBills           VendorBill[]
  communicationContacts CommunicationContact[]
  milestones            ProgressMilestone[]
  hindrances            ProgressHindrance[]
  risks                 ProgressRisk[]
  plannedActual         ProgressPlannedActual[]
  legalApprovals        ProgressLegalApproval[]
  manpowerRows          ProgressManpower[]
  activityLines         ProgressActivityLine[]
  sorStats              ProgressSorStat[]
  qapActivities         QapActivity[]
  cubeTests             CubeTest[]
  qualityNcrs           QualityNcr[]
  purchaseOrders        PurchaseOrder[]
  raBills               RaBill[]
  certificates          CertificateOfPayment[]
  capexLines            ProjectCapex[]
  quotations            Quotation[]
}

/**
 * Mock / queued outbound emails (swap to SMTP/Graph later)
 */
model EmailOutbox {
  id          String    @id @default(cuid())
  projectId   String?
  toEmails    String
  subject     String
  body        String
  context     String?
  status      String    @default("Queued")
  createdById String?
  createdAt   DateTime  @default(now())
  sentAt      DateTime?

  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  role      String   @default("member")
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
}

model DocumentFolder {
  id           String    @id @default(cuid())
  projectId    String
  path         String
  name         String
  parentPath   String?
  mockDriveId  String?
  lastSyncedAt DateTime?
  createdAt    DateTime  @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, path])
}

model Drawing {
  id            String   @id @default(cuid())
  projectId     String
  drawingNumber String
  title         String
  discipline    String   @default("Architecture")
  buildingArea  String?
  tlNo          String?
  currentRev    String   @default("R0")
  status        String   @default("Draft")
  isPublished   Boolean  @default(false)
  folderPath    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  project     Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  revisions   DrawingRevision[]
  submissions ChecklistSubmission[]
  rfis        Rfi[]
  inspections QualityInspection[]

  @@unique([projectId, drawingNumber])
}

model DrawingRevision {
  id                   String    @id @default(cuid())
  drawingId            String
  revisionNumber       String
  revisionLabel        String?
  fileUrl              String
  fileName             String?
  published            Boolean   @default(false)
  /// Planned issue date (GFC register column)
  plannedDate          DateTime?
  /// Actual upload / issue date
  actualDate           DateTime?
  uploadedById         String?
  /// Pre-upload drawing check submission that unlocked this revision
  preCheckSubmissionId String?
  createdAt            DateTime  @default(now())

  drawing        Drawing               @relation(fields: [drawingId], references: [id], onDelete: Cascade)
  uploadedBy     User?                 @relation("DrawingUploader", fields: [uploadedById], references: [id])
  checklistFills ChecklistSubmission[]
}

model ChecklistTemplate {
  id               String   @id @default(cuid())
  name             String
  category         String
  /// DrawingCheck | SiteExecution | QualityInspection | Safety
  checklistType    String   @default("SiteExecution")
  source           String?
  /// QA / fill instructions shown on the form
  instructions     String?
  /// Minimum photos required on submit (Quality/Safety typically 3)
  requirePhotosMin Int      @default(0)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt

  items       ChecklistItem[]
  assignments ChecklistAssignment[]
}

model ChecklistItem {
  id           String  @id @default(cuid())
  templateId   String
  itemCode     String?
  description  String
  /// Per-line quality / safety instruction
  instruction  String?
  sortOrder    Int     @default(0)
  section      String?
  requirePhoto Boolean @default(false)

  template ChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
}

model ChecklistAssignment {
  id         String   @id @default(cuid())
  projectId  String
  templateId String
  status     String   @default("Assigned")
  assignedAt DateTime @default(now())

  project     Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  template    ChecklistTemplate     @relation(fields: [templateId], references: [id], onDelete: Cascade)
  submissions ChecklistSubmission[]

  @@unique([projectId, templateId])
}

model ChecklistSubmission {
  id             String    @id @default(cuid())
  assignmentId   String
  drawingId      String?
  revisionId     String?
  revisionNumber String?
  submittedById  String
  status         String    @default("Draft")
  responsesJson  String
  remarks        String?
  /// Fill | PreUploadDrawing
  purpose        String    @default("Fill")
  /// One-time token consumed when drawing/revision upload succeeds
  unlockToken    String?   @unique
  unlockUsedAt   DateTime?
  reviewedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  assignment  ChecklistAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  drawing     Drawing?            @relation(fields: [drawingId], references: [id])
  revision    DrawingRevision?    @relation(fields: [revisionId], references: [id])
  submittedBy User                @relation(fields: [submittedById], references: [id])
  photos      ChecklistPhoto[]
}

model ChecklistPhoto {
  id           String   @id @default(cuid())
  submissionId String
  /// Checklist template item this evidence belongs to (null = whole submission)
  itemId       String?
  /// photo | doc
  kind         String   @default("photo")
  fileUrl      String
  caption      String?
  comment      String?
  createdAt    DateTime @default(now())

  submission ChecklistSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
}

model DailyLog {
  id               String    @id @default(cuid())
  projectId        String
  logDate          DateTime
  weatherCondition String?
  weatherSource    String?
  status           String    @default("Open")
  createdById      String
  completedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  project   Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User                @relation("DailyLogCreator", fields: [createdById], references: [id])
  manpower  DailyLogManpower[]
  equipment DailyLogEquipment[]
  notes     DailyLogNote[]
  photos    DailyLogPhoto[]

  @@unique([projectId, logDate])
}

model DailyLogManpower {
  id          String  @id @default(cuid())
  dailyLogId  String
  companyName String
  workerCount Int
  hoursWorked Float   @default(8)
  comments    String?

  dailyLog DailyLog @relation(fields: [dailyLogId], references: [id], onDelete: Cascade)
}

model DailyLogEquipment {
  id            String  @id @default(cuid())
  dailyLogId    String
  companyName   String
  equipmentType String
  hoursUsed     Float?
  comments      String?

  dailyLog DailyLog @relation(fields: [dailyLogId], references: [id], onDelete: Cascade)
}

model DailyLogNote {
  id         String   @id @default(cuid())
  dailyLogId String
  noteText   String
  createdAt  DateTime @default(now())

  dailyLog DailyLog @relation(fields: [dailyLogId], references: [id], onDelete: Cascade)
}

model DailyLogPhoto {
  id         String   @id @default(cuid())
  dailyLogId String
  fileUrl    String
  caption    String?
  createdAt  DateTime @default(now())

  dailyLog DailyLog @relation(fields: [dailyLogId], references: [id], onDelete: Cascade)
}

model CommunicationMatrix {
  id                String   @id @default(cuid())
  projectId         String
  communicationType String
  fromRole          String
  toRole            String
  frequency         String
  channel           String   @default("Email")
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

/**
 * BPCL-style contact matrix (TECHNICAL / COMMERCIAL) — Name, Designation, Company, SPOC, Mobile, Email, TO/CC
 */
model CommunicationContact {
  id              String   @id @default(cuid())
  projectId       String
  /// TECHNICAL | COMMERCIAL
  matrixKind      String   @default("TECHNICAL")
  /// Client | PMC | Consultant | Contractor | Other
  orgSection      String
  orgName         String
  /// true = section header row (org name only)
  isSectionHeader Boolean  @default(false)
  sortOrder       Int      @default(0)
  personName      String?
  designation     String?
  company         String?
  spoc            String?
  mobile          String?
  email           String?
  /// TO | CC
  mailRole        String?
  officeAddress   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, matrixKind])
}

model CommunicationLog {
  id        String   @id @default(cuid())
  projectId String
  subject   String
  body      String?
  fromUser  String?
  toRoles   String
  channel   String   @default("In-App")
  sentAt    DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Meeting {
  id              String   @id @default(cuid())
  projectId       String
  title           String
  meetingDate     DateTime
  location        String?
  /// Agenda → MoM → Follow-up → Closed (client video flow)
  status          String   @default("Agenda")
  /// Optional link to parent MoM when this is a follow-up
  parentMeetingId String?
  agendaNotes     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  project Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  items   MeetingItem[]
}

model MeetingItem {
  id               String    @id @default(cuid())
  meetingId        String
  /// Agenda | MoM | Action | Follow-up
  category         String    @default("Agenda")
  description      String
  assignedToId     String?
  dueDate          DateTime?
  priority         String    @default("Medium")
  resolutionStatus String    @default("Open")
  carriedOverFrom  String?

  meeting    Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  assignedTo User?   @relation(fields: [assignedToId], references: [id])
}

/// COP / RA bill tracker — vendor bill entries (client video)
model VendorBill {
  id            String   @id @default(cuid())
  projectId     String
  vendorId      String?
  vendorName    String
  billNo        String
  billDate      DateTime @default(now())
  amount        Float    @default(0)
  gstAmount     Float    @default(0)
  /// Draft | Submitted | Under review | Certified | Paid | Rejected
  status        String   @default("Draft")
  copNo         String?
  description   String?
  attachmentUrl String?
  createdById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  vendor  Vendor? @relation(fields: [vendorId], references: [id])
}

model CostBudgetLine {
  id               String   @id @default(cuid())
  projectId        String
  srNo             String?
  description      String
  stakeholder      String?
  budgetedAmount   Float    @default(0)
  workOrderAmount  Float    @default(0)
  certifiedAmount  Float    @default(0)
  forecastedAmount Float    @default(0)
  nonTendered      Float    @default(0)
  createdAt        DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model CostMonitoringLine {
  id           String   @id @default(cuid())
  projectId    String
  packageName  String   @default("Civil")
  /// BOQ section heading (e.g. SECTION A — EARTH WORK)
  section      String?
  itemNo       String?
  description  String
  uom          String?
  rate         Float    @default(0)
  boqQty       Float    @default(0)
  extraQty     Float    @default(0)
  gfcQty       Float    @default(0)
  achievedQty  Float    @default(0)
  certifiedQty Float    @default(0)
  excessQty    Float    @default(0)
  savingQty    Float    @default(0)
  boqCost      Float    @default(0)
  createdAt    DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

/**
 * Measurement book line (from SPDC Budget * MB sheets)
 */
model CostMbLine {
  id          String   @id @default(cuid())
  projectId   String
  packageName String   @default("Civil")
  srNo        String?
  description String
  nos1        Float    @default(0)
  nos2        Float    @default(0)
  length      Float    @default(0)
  width       Float    @default(0)
  height      Float    @default(0)
  qty         Float    @default(0)
  unit        String?
  createdAt   DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

/**
 * Bar bending schedule line (from * BBS sheets)
 */
model CostBbsLine {
  id          String   @id @default(cuid())
  projectId   String
  packageName String   @default("Civil")
  barMark     String?
  diameterMm  Float    @default(0)
  shape       String?
  lengthMm    Float    @default(0)
  nos         Float    @default(0)
  totalLength Float    @default(0)
  weightKg    Float    @default(0)
  location    String?
  createdAt   DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model CostCashflowPeriod {
  id            String    @id @default(cuid())
  projectId     String
  periodLabel   String
  periodDate    DateTime?
  packageName   String
  plannedAmount Float     @default(0)
  actualAmount  Float     @default(0)
  progressPct   Float     @default(0)
  createdAt     DateTime  @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model CostRateDifference {
  id           String   @id @default(cuid())
  projectId    String
  materialType String
  description  String
  vendorName   String?
  purchaseNo   String?
  qty          Float    @default(0)
  basicRate    Float    @default(0)
  purchaseRate Float    @default(0)
  excessAmount Float    @default(0)
  savingAmount Float    @default(0)
  createdAt    DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model BoqImportBatch {
  id          String   @id @default(cuid())
  projectId   String
  fileName    String
  rowCount    Int      @default(0)
  status      String   @default("Imported")
  summaryJson String?
  createdAt   DateTime @default(now())

  project Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  items   BoqItem[]
}

model BoqItem {
  id          String  @id @default(cuid())
  batchId     String
  srNo        String?
  description String
  section     String?
  qty         Float   @default(0)
  rate        Float   @default(0)
  unit        String?
  amount      Float   @default(0)
  costCode    String?
  rowKind     String  @default("item")

  batch BoqImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
}

model AuditEvent {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String?
  entityId  String?
  metaJson  String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])
}

model Lead {
  id          String   @id @default(cuid())
  projectId   String?
  title       String
  contactName String?
  email       String?
  phone       String?
  stage       String   @default("New")
  value       Float?
  ownerId     String?
  createdAt   DateTime @default(now())

  project    Project?    @relation(fields: [projectId], references: [id])
  owner      User?       @relation(fields: [ownerId], references: [id])
  quotations Quotation[]
  bidPackages CrmBidPackage[]
}

model Deal {
  id        String   @id @default(cuid())
  projectId String?
  name      String
  stage     String   @default("Negotiation")
  value     Float    @default(0)
  createdAt DateTime @default(now())

  project Project? @relation(fields: [projectId], references: [id])
}

model EmployeeProfile {
  id                    String    @id @default(cuid())
  userId                String    @unique
  empCode               String    @unique
  department            String?
  designation           String?
  joinDate              DateTime?
  dateOfBirth           DateTime?
  gender                String?
  maritalStatus         String?
  bloodGroup            String?
  personalEmail         String?
  personalPhone         String?
  emergencyContactName  String?
  emergencyContactPhone String?
  addressCurrent        String?
  addressPermanent      String?
  bankName              String?
  bankAccountNo         String?
  bankIfsc              String?
  panNumber             String?
  aadhaarNumber         String?
  pfNumber              String?
  esicNumber            String?
  nomineeName           String?
  nomineeRelation       String?
  reportingManagerId    String?
  ctcAnnual             Float?
  basicMonthly          Float?
  hraMonthly            Float?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @default(now()) @updatedAt
}

model Attendance {
  id            String   @id @default(cuid())
  userId        String
  date          DateTime
  status        String   @default("Present")
  checkIn       String?
  checkOut      String?
  /// GPS + geofence
  inLat         Float?
  inLng         Float?
  inAccuracy    Float?
  outLat        Float?
  outLng        Float?
  outAccuracy   Float?
  inPhotoUrl    String?
  outPhotoUrl   String?
  inSiteName    String?
  outSiteName   String?
  inGeofenceOk  Boolean  @default(false)
  outGeofenceOk Boolean  @default(false)
  projectId     String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model LeaveType {
  id               String   @id @default(cuid())
  code             String   @unique
  name             String
  daysPerYear      Float    @default(0)
  isPaid           Boolean  @default(true)
  carryForward     Boolean  @default(false)
  requiresApproval Boolean  @default(true)
  colour           String?  @default("#7B4DFF")
  createdAt        DateTime @default(now())

  balances LeaveBalance[]
  requests LeaveRequest[]
}

model LeaveBalance {
  id          String @id @default(cuid())
  userId      String
  leaveTypeId String
  year        Int
  entitled    Float  @default(0)
  used        Float  @default(0)
  balance     Float  @default(0)

  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@unique([userId, leaveTypeId, year])
}

model LeaveRequest {
  id           String    @id @default(cuid())
  userId       String
  leaveTypeId  String?
  fromDate     DateTime
  toDate       DateTime
  days         Float     @default(1)
  halfDay      Boolean   @default(false)
  reason       String?
  /// Pending | Approved | Rejected | Cancelled
  status       String    @default("Pending")
  approverId   String?
  decidedAt    DateTime?
  decisionNote String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  leaveType LeaveType? @relation(fields: [leaveTypeId], references: [id])
}

model Holiday {
  id         String   @id @default(cuid())
  date       DateTime
  name       String
  region     String?  @default("India")
  isOptional Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@unique([date, name])
}

model EmployeeDocument {
  id          String    @id @default(cuid())
  userId      String
  category    String
  title       String
  fileUrl     String
  storagePath String?
  issuedOn    DateTime?
  validTill   DateTime?
  createdAt   DateTime  @default(now())
}

/**
 * Manpower Requisition — a dept opens it; HR approves before we post the job.
 */
model ManpowerRequisition {
  id               String    @id @default(cuid())
  requisitionNo    String    @unique
  department       String
  designation      String
  count            Int       @default(1)
  employmentType   String    @default("Permanent")
  reportingManager String?
  justification    String?
  urgency          String?   @default("Normal")
  ctcRangeMin      Float?
  ctcRangeMax      Float?
  location         String?
  requestedById    String
  approvedById     String?
  approvedAt       DateTime?
  /// Draft | Submitted | Approved | Rejected | Closed
  status           String    @default("Submitted")
  rejectionReason  String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @default(now()) @updatedAt

  postings JobPosting[]
}

/**
 * Job Posting — sourcing channels (LinkedIn / Naukri / Website / Referral).
 */
model JobPosting {
  id             String    @id @default(cuid())
  requisitionId  String?
  title          String
  department     String?
  location       String?
  employmentType String?   @default("Permanent")
  description    String?
  requirements   String?
  channelsJson   String?   @default("[]")
  postedAt       DateTime?
  closedAt       DateTime?
  /// Open | Closed | On-Hold
  status         String    @default("Open")
  postedById     String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt

  requisition ManpowerRequisition? @relation(fields: [requisitionId], references: [id])
  candidates  Candidate[]
}

/**
 * Candidate — resume database. Moves through stages until Offered/Joined.
 */
model Candidate {
  id               String   @id @default(cuid())
  postingId        String?
  fullName         String
  email            String?
  phone            String?
  sourceChannel    String?
  resumeUrl        String?
  currentCompany   String?
  currentDesign    String?
  currentCtc       Float?
  expectedCtc      Float?
  noticePeriodDays Int?
  experienceYears  Float?
  skills           String?
  location         String?
  /// New | Screened | Shortlisted | Interview | Selected | Offered | Joined | Rejected | Withdrawn
  status           String   @default("New")
  screenedById     String?
  rejectionReason  String?
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt

  posting    JobPosting?      @relation(fields: [postingId], references: [id])
  interviews InterviewRound[]
  offers     Offer[]
}

/**
 * Interview Round — technical / HR / management.
 * Meeting link (Teams / Zoom / in-person) + panel + scorecard.
 */
model InterviewRound {
  id                 String    @id @default(cuid())
  candidateId        String
  roundNumber        Int       @default(1)
  roundType          String
  panelJson          String?   @default("[]")
  scheduledAt        DateTime?
  durationMins       Int?      @default(60)
  mode               String    @default("Teams")
  meetingLink        String?
  meetingId          String?
  feedbackTechnical  String?
  feedbackHr         String?
  feedbackMgmt       String?
  scoreTechnical     Float?
  scoreCommunication Float?
  scoreCulture       Float?
  scoreOverall       Float?
  /// Scheduled | Completed | No-Show | Cancelled
  status             String    @default("Scheduled")
  /// Advance | Reject | Hold
  decision           String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @default(now()) @updatedAt

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
}

/**
 * Offer letter — CTC breakdown, joining date, approval workflow.
 */
model Offer {
  id                String    @id @default(cuid())
  candidateId       String
  offerNo           String    @unique
  designation       String
  department        String?
  ctcAnnual         Float
  basicMonthly      Float?
  hraMonthly        Float?
  otherAllowMonthly Float?
  variablePayPct    Float?
  joiningDate       DateTime?
  probationMonths   Int?      @default(6)
  location          String?
  reportingManager  String?
  offerLetterUrl    String?
  approvedById      String?
  approvedAt        DateTime?
  sentAt            DateTime?
  acceptedAt        DateTime?
  declinedAt        DateTime?
  joinedAt          DateTime?
  /// Draft | Approved | Sent | Accepted | Declined | Withdrawn | Joined
  status            String    @default("Draft")
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @default(now()) @updatedAt

  candidate Candidate            @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  preJoin   PreJoiningChecklist?
  onboard   OnboardingChecklist?
}

/**
 * Pre-Joining Checklist — document collection, BGV, medical, IT asset, ID card, welcome kit.
 */
model PreJoiningChecklist {
  id                   String    @id @default(cuid())
  offerId              String    @unique
  empCodeGenerated     String?
  appointmentLetterUrl String?
  docCollectionDone    Boolean   @default(false)
  docCollectionAt      DateTime?
  bgvStatus            String    @default("Pending")
  bgvAt                DateTime?
  medicalStatus        String    @default("Pending")
  medicalAt            DateTime?
  itAssetRequested     Boolean   @default(false)
  itAssetIssuedAt      DateTime?
  itAssetDetails       String?
  emailCreated         Boolean   @default(false)
  emailCreatedAt       DateTime?
  emailAddress         String?
  idCardRequested      Boolean   @default(false)
  idCardIssuedAt       DateTime?
  welcomeKitPrepared   Boolean   @default(false)
  welcomeKitAt         DateTime?
  notes                String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @default(now()) @updatedAt

  offer Offer @relation(fields: [offerId], references: [id], onDelete: Cascade)
}

/**
 * Onboarding Checklist — joining formalities, personal info, doc verification, HR policy ack.
 * Stateful list of every item + who / when it was ticked.
 */
model OnboardingChecklist {
  id                       String   @id @default(cuid())
  offerId                  String   @unique
  userId                   String?
  joiningFormalitiesDone   Boolean  @default(false)
  personalInfoDone         Boolean  @default(false)
  bankDetailsDone          Boolean  @default(false)
  panAadhaarDone           Boolean  @default(false)
  pfEsicDone               Boolean  @default(false)
  nomineeDone              Boolean  @default(false)
  docVerificationDone      Boolean  @default(false)
  departmentAllocated      Boolean  @default(false)
  reportingManagerAssigned Boolean  @default(false)
  orientationDone          Boolean  @default(false)
  hrPolicyAcknowledged     Boolean  @default(false)
  itemsCompletedAtJson     String   @default("{}")
  notes                    String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @default(now()) @updatedAt

  offer Offer @relation(fields: [offerId], references: [id], onDelete: Cascade)
}

/**
 * Pay Hike — salary revision with old/new snapshot, reason, approval.
 */
model PayHike {
  id                String    @id @default(cuid())
  userId            String
  effectiveDate     DateTime
  oldCtcAnnual      Float
  newCtcAnnual      Float
  hikePercent       Float
  oldBasicMonthly   Float?
  newBasicMonthly   Float?
  oldHraMonthly     Float?
  newHraMonthly     Float?
  reason            String?
  performanceRating String?
  approvedById      String?
  approvedAt        DateTime?
  /// Draft | Submitted | Approved | Rejected | Applied
  status            String    @default("Submitted")
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @default(now()) @updatedAt
}

/**
 * Payslip — one row per user per month. Auto-generated from EmployeeProfile + adjustments.
 */
model Payslip {
  id              String   @id @default(cuid())
  userId          String
  year            Int
  month           Int
  workingDays     Float    @default(0)
  paidDays        Float    @default(0)
  lopDays         Float    @default(0)
  basic           Float    @default(0)
  hra             Float    @default(0)
  conveyance      Float    @default(0)
  medicalAllow    Float    @default(0)
  specialAllow    Float    @default(0)
  otherEarnings   Float    @default(0)
  grossEarnings   Float    @default(0)
  pfEmployee      Float    @default(0)
  esicEmployee    Float    @default(0)
  professionalTax Float    @default(0)
  incomeTax       Float    @default(0)
  otherDeduction  Float    @default(0)
  totalDeductions Float    @default(0)
  netPay          Float    @default(0)
  status          String   @default("Generated")
  generatedAt     DateTime @default(now())
  generatedById   String?
  fileUrl         String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt

  @@unique([userId, year, month])
}

model CustomSheet {
  id          String   @id @default(cuid())
  projectId   String?
  name        String
  category    String?
  headersJson String
  rowsJson    String
  sourceFile  String?
  storagePath String?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/**
 * DPR snapshot — one row per (project × logDate × discipline).
 * Persists the DPR maker's header + BOQ line inputs so the same DPR
 * can be re-opened, edited, and re-published without losing state.
 *
 * headerJson: {
 *   projectManager, contractor, location, contractRef, contractCompletion,
 *   calendarHours, shiftHours, weather, reportDate, dataDate, reportNumber,
 *   acCertifiedToDate, cumManDaysPrev, cumSafeManHoursPrev, dateOfLastLti
 * }
 * linesJson: [
 *   { group, description, unit, scopeQty, rate, start, finish,
 *     cumQtyPrev, qtyToday, remarks }
 * ]
 * Discipline: CIVIL | ELECTRICAL | FIRE | MECHANICAL | PEB_ERECTION |
 *             PEB_SUPPLY | PLUMBING
 */
model DprSnapshot {
  id             String    @id @default(cuid())
  projectId      String
  logDate        DateTime
  discipline     String    @default("CIVIL")
  headerJson     String    @default("{}")
  linesJson      String    @default("[]")
  status         String    @default("Draft")
  publishedAt    DateTime?
  publishedPath  String?
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt

  @@unique([projectId, logDate, discipline])
  @@index([projectId, logDate])
}

/**
 * WPR snapshot — one row per (project × weekEnding).
 * Persists the multi-section WPR maker's editable content so it can be
 * re-opened and re-published.
 *
 * sectionsJson: {
 *   brief, stakeholders, mobilisation, communicationMatrix,
 *   projectDashboard, criticalAreas, capex, prTracker, hindrance, risk,
 *   legal, drawingRegister, designStatus, procurement, milestones,
 *   manpowerHistogram, weeklyExecuted, cashflow, quality, safety,
 *   plannedVsActual, materialStock, progressPictures
 * }  (each is { title, notes, tableRows[], imagePaths[] })
 */
model WprSnapshot {
  id             String    @id @default(cuid())
  projectId      String
  weekEnding     DateTime
  reportNumber   Int?
  sectionsJson   String    @default("{}")
  status         String    @default("Draft")
  publishedAt    DateTime?
  publishedPath  String?
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt

  @@unique([projectId, weekEnding])
  @@index([projectId, weekEnding])
}

// —— Procore-style directory, RFI, QA ——

model Vendor {
