/**
 * Purchase Order — contract / WO to a vendor. Anchors RA bills, invoices and COPs.
 * Mirrors columns from Payment Summary (WO/PO no & date, original value, amendments).
 */
model PurchaseOrder {
  id                    String    @id @default(cuid())
  projectId             String
  poNumber              String
  poDate                DateTime?
  vendorId              String?
  vendorName            String
  workTrade             String?
  packageName           String?
  budgetCode            String?
  originalValue         Float     @default(0)
  amendmentNo           String?
  amendedValue          Float     @default(0)
  retentionPct          Float     @default(5)
  advancePct            Float     @default(0)
  advanceAdjustedAmt    Float     @default(0)
  totalBilledWithoutGst Float     @default(0)
  totalBilledWithGst    Float     @default(0)
  totalCertified        Float     @default(0)
  totalPaid             Float     @default(0)
  status                String    @default("Active")
  attachmentUrl         String?
  panNumber             String?
  gstNumber             String?
  payableTo             String?
  createdById           String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  project      Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  vendor       Vendor?                @relation(fields: [vendorId], references: [id])
  raBills      RaBill[]
  certificates CertificateOfPayment[]

  @@unique([projectId, poNumber])
}

/**
 * RA Bill (Running Account bill) — vendor invoice against a PO.
 * Mirrors Payment Summary "CIVIL RA Bill" columns: invoice, price variation, GST,
 * advance adjusted, retention, net payable, cumulative.
 */
model RaBill {
  id                     String    @id @default(cuid())
  projectId              String
  purchaseOrderId        String?
  raNumber               String
  invoiceNumber          String?
  invoiceDate            DateTime?
  description            String?
  againstBillRaised      Float     @default(0)
  priceVariation         Float     @default(0)
  totalInvoiceWithoutGst Float     @default(0)
  gstAmount              Float     @default(0)
  totalInvoiceWithGst    Float     @default(0)
  advanceAdjusted        Float     @default(0)
  retentionAmount        Float     @default(0)
  otherRecoveries        Float     @default(0)
  netAmountPayable       Float     @default(0)
  previousBillTotal      Float     @default(0)
  cumulativeBillTotal    Float     @default(0)
  /// Draft | Submitted | Under Review | Certified | Paid | Rejected
  status                 String    @default("Submitted")
  discipline             String?
  vendorId               String?
  vendorName             String?
  copNo                  String?
  attachmentUrl          String?
  createdById            String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  project       Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  vendor        Vendor?                @relation(fields: [vendorId], references: [id])
  purchaseOrder PurchaseOrder?         @relation(fields: [purchaseOrderId], references: [id])
  certificates  CertificateOfPayment[]
  revisions     RaBillRevision[]

  @@index([projectId, purchaseOrderId])
  @@index([projectId, discipline])
}

/**
 * RA Bill Revision — every "Submitted / Corrected / Certified" click uploads a new file.
 * We keep the full log per bill so PMC can open each version directly in SharePoint and
 * see who submitted what, when, and where the change happened. No re-typing, no custom form —
 * every contractor drops their own workbook and we log the trail.
 */
model RaBillRevision {
  id            String   @id @default(cuid())
  raBillId      String
  /// Submitted | Corrected | Certified
  stage         String
  /// 1 = first Submitted, 2 = first Corrected, etc.  Multiple Corrected revisions are allowed.
  revisionNo    Int      @default(1)
  fileName      String?
  fileUrl       String?
  storagePath   String?
  sharePointUrl String?
  amountAtStage Float?
  notes         String?  @db.Text
  uploadedById  String?
  uploadedAt    DateTime @default(now())

  raBill RaBill @relation(fields: [raBillId], references: [id], onDelete: Cascade)

  @@index([raBillId, stage])
}

/**
 * HRMS Document — generated / uploaded letters (Appointment, Relieving, Exit, Asset Return, Offer).
 * The system stores the form data in `dataJson`, generates a .docx from the format in
 * apps/api/formats/hrms/*.docx (branded with Sharnam letterhead), and also accepts the signed
 * scanned copy back. Everything lands under 06_HR_ADMIN on SharePoint / mock OneDrive.
 */
model HrmsDocument {
  id               String    @id @default(cuid())
  /// Appointment | Relieving | Exit | AssetReturn | Offer | Confirmation | Warning | Experience
  kind             String
  refNo            String
  employeeUserId   String?
  employeeName     String
  candidateEmail   String?
  designation      String?
  department       String?
  issueDate        DateTime  @default(now())
  effectiveDate    DateTime?
  /// Draft | Generated | Sent | Signed | Cancelled
  status           String    @default("Draft")
  dataJson         String    @db.Text
  generatedDocxUrl String?
  generatedPdfUrl  String?
  uploadedFileUrl  String?
  sharePointUrl    String?
  storagePath      String?
  createdById      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @default(now()) @updatedAt

  @@unique([kind, refNo])
  @@index([employeeUserId, kind])
}

/**
 * Certificate of Payment (COP) — the certified letter that authorises payment
 * against a specific RA bill or material advance. Format matches Viatrix_RA BILL_COP.xlsm.
 */
model CertificateOfPayment {
  id                String    @id @default(cuid())
  projectId         String
  certificateNumber String
  certificateType   String?
  certificateDate   DateTime?
  contractor        String
  workTrade         String?
  budgetCode        String?
  purchaseOrderId   String?
  poNumberDate      String?
  originalWoValue   Float     @default(0)
  amendmentNo       String?
  amendedWoValue    Float     @default(0)
  invoiceNoDate     String?
  raBillId          String?
  amountCertified   Float     @default(0)
  amountPayable     Float     @default(0)
  gstAmount         Float     @default(0)
  retentionAmount   Float     @default(0)
  panNumber         String?
  gstNumber         String?
  payableTo         String?
  remarks           String?
  /// Draft | Certified | Approved | Paid | Rejected
  status            String    @default("Draft")
  attachmentUrl     String?
  createdById       String?
  certifiedById     String?
  approvedById      String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  raBill        RaBill?        @relation(fields: [raBillId], references: [id])

  @@unique([projectId, certificateNumber])
}

