generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  fullName     String
  role         String   @default("office")
  portal       String   @default("office")
  phone        String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships           ProjectMember[]
  uploadedDrawings      DrawingRevision[]           @relation("DrawingUploader")
  uploadedDrawingMarkup DrawingRevisionMarkupPage[] @relation("DrawingMarkupUploader")
  checklistSubmissions  ChecklistSubmission[]
  dailyLogsCreated      DailyLog[]                  @relation("DailyLogCreator")
  auditEvents           AuditEvent[]
  meetingItems          MeetingItem[]
  leadsOwned            Lead[]
  attendance            Attendance[]
  leaveRequests         LeaveRequest[]
  rfisCreated           Rfi[]                       @relation("RfiCreator")
  rfisAssigned          Rfi[]                       @relation("RfiAssignee")
  rfiResponses          RfiResponse[]
  inspectionsCreated    QualityInspection[]         @relation("InspectionCreator")
  inspectionsAssigned   QualityInspection[]         @relation("InspectionAssignee")
  safetyReported        SafetyRecord[]              @relation("SafetyReporter")
  safetyAssigned        SafetyRecord[]              @relation("SafetyAssignee")
  qualitySiteReported   QualitySiteRecord[]         @relation("QualitySiteReporter")
}

model RoleDefinition {
  id          String   @id @default(cuid())
  key         String   @unique
  label       String
  portal      String
  permissions String   @db.Text
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Project {
  id                      String    @id @default(cuid())
  code                    String    @unique
  name                    String
  clientName              String?
  /// Client / stakeholder card (CRM → project)
  clientContactName       String?
  clientEmail             String?
  clientPhone             String?
  clientAddress           String?
  clientGst               String?
  designConsultant        String?
  contractorName          String?
  /// PMC / SPDC name shown on QAP, cube and other register headers
  pmcName                 String?
  /// Client logo for register headers (SharePoint or local uploads URL)
  clientLogoUrl           String?
  location                String?
  status                  String    @default("Planning")
  startDate               DateTime?
  endDate                 DateTime?
  /// Comma-separated notification emails for this project
  notificationEmails      String?
  /// Comma-separated WhatsApp mobiles (10-digit India or +91…)
  notificationWhatsApp    String?
  emailFromName           String?   @default("शरणम् Portal")
  emailEnabled            Boolean   @default(true)
  whatsAppEnabled         Boolean   @default(true)
  notifyOnDrawingPublish  Boolean   @default(true)
  notifyOnChecklistSubmit Boolean   @default(true)
  /// Outlook / Microsoft 365 mailbox for project mail (Graph when configured)
  outlookMailbox          String?
  outlookConnected        Boolean   @default(false)
  outlookConnectedAt      DateTime?
  /// JSON array of enabled module keys (drawings, quality, safety, progress, …)
  enabledModules          String    @default("[\"drawings\",\"dms\",\"quality\",\"safety\",\"inspection\",\"progress\",\"comms\",\"auditKpi\",\"cost\",\"finance\",\"reports\",\"closure\"]") @db.Text
  /// JSON array of work packages e.g. Civil, PEB, Electrical
  workPackages            String    @default("[\"Civil\",\"PEB\"]") @db.Text
  /// Default R2 bid disciplines for CRM packages on this project (JSON array of {key,label,sheetName})
  bidDisciplinesJson      String?   @db.Text
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  members                 ProjectMember[]
  drawings                Drawing[]
  folders                 DocumentFolder[]
  checklistAssignments    ChecklistAssignment[]
  dailyLogs               DailyLog[]
  commMatrix              CommunicationMatrix[]
  commLogs                CommunicationLog[]
  meetings                Meeting[]
  budgetLines             CostBudgetLine[]
  monitoringLines         CostMonitoringLine[]
  cashflowPeriods         CostCashflowPeriod[]
  boqBatches              BoqImportBatch[]
  rateDiffs               CostRateDifference[]
  mbLines                 CostMbLine[]
  bbsLines                CostBbsLine[]
  leads                   Lead[]
  deals                   Deal[]
  vendors                 ProjectVendor[]
  rfis                    Rfi[]
  inspections             QualityInspection[]
  photos                  ProjectPhoto[]
  submittals              Submittal[]
  coordinationIssues      DesignCoordinationIssue[]
  safetyRecords           SafetyRecord[]
  emailOutbox             EmailOutbox[]
  vendorBills             VendorBill[]
  communicationContacts   CommunicationContact[]
  milestones              ProgressMilestone[]
  hindrances              ProgressHindrance[]
  risks                   ProgressRisk[]
  plannedActual           ProgressPlannedActual[]
  legalApprovals          ProgressLegalApproval[]
  manpowerRows            ProgressManpower[]
  activityLines           ProgressActivityLine[]
  sorStats                ProgressSorStat[]
  qapActivities           QapActivity[]
  cubeTests               CubeTest[]
  qualityNcrs             QualityNcr[]
  qualitySiteRecords      QualitySiteRecord[]
  purchaseOrders          PurchaseOrder[]
  raBills                 RaBill[]
  certificates            CertificateOfPayment[]
  financeMaterialInvoices FinanceMaterialInvoice[]
  capexLines              ProjectCapex[]
  quotations              Quotation[]
  bidPackages             CrmBidPackage[]
  drawingRegisterLines    DrawingRegisterLine[]
  snagItems               SnagItem[]
  lessonsLearnt           LessonLearnt[]
  closureReport           ProjectClosureReport?
  siteAudits              SiteAudit[]
  auditFindings           AuditFinding[]
  auditChecklistItems     AuditChecklistItem[]
  kpiSubjects             KpiSubject[]
  kpiRoleKras             KpiRoleKra[]
}

/**
 * Mock / queued outbound emails (swap to SMTP/Graph later)
 */
model EmailOutbox {
  id          String    @id @default(cuid())
  projectId   String?
  toEmails    String
  subject     String
  body        String    @db.Text
  context     String?
  status      String    @default("Queued")
  createdById String?
  createdAt   DateTime  @default(now())
  sentAt      DateTime?

  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  role      String   @default("member")
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
}

model DocumentFolder {
  id           String    @id @default(cuid())
  projectId    String
  path         String
  name         String
  parentPath   String?
  mockDriveId  String?
  lastSyncedAt DateTime?
  createdAt    DateTime  @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, path])
}

model Drawing {
  id            String   @id @default(cuid())
  projectId     String
  drawingNumber String
  title         String
  discipline    String   @default("Architecture")
  buildingArea  String?
  tlNo          String?
  currentRev    String   @default("R0")
  status        String   @default("Draft")
  isPublished   Boolean  @default(false)
  folderPath    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  project      Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  revisions    DrawingRevision[]
  submissions  ChecklistSubmission[]
  rfis         Rfi[]
  inspections  QualityInspection[]
  registerLine DrawingRegisterLine?

  @@unique([projectId, drawingNumber])
}

model DrawingRevision {
  id                       String    @id @default(cuid())
  drawingId                String
  revisionNumber           String
  revisionLabel            String?
  /// Primary preview URL (PDF preferred, else DWG) — kept for backward compatibility
  fileUrl                  String
  fileName                 String?
  pdfFileUrl               String?
  pdfFileName              String?
  dwgFileUrl               String?
  dwgFileName              String?
  published                Boolean   @default(false)
  /// Planned issue date (GFC register column)
  plannedDate              DateTime?
  /// Actual upload / issue date
  actualDate               DateTime?
  uploadedById             String?
  /// Pre-upload drawing check submission that unlocked this revision
  preCheckSubmissionId     String?
  /// Site drawing register — receive & issue (per revision R0–Rn)
  receivedDate             DateTime?
  copiesReceived           Int?
  issuedToContractorAt     DateTime?
  contractorSignName       String?
  contractorSignUrl        String?
  contractorSignFileName   String?
  issuedToClientAt         DateTime?
  clientSignName           String?
  clientSignUrl            String?
  clientSignFileName       String?
  /// PMC approval signature (from photo storage or upload)
  pmcSignName              String?
  pmcSignUrl               String?
  pmcSignFileName          String?
  /// Site engineer signature (from photo storage or upload)
  siteEngineerSignName     String?
  siteEngineerSignUrl      String?
  siteEngineerSignFileName String?
  issueRemarks             String?
  createdAt                DateTime  @default(now())

  drawing        Drawing                     @relation(fields: [drawingId], references: [id], onDelete: Cascade)
  uploadedBy     User?                       @relation("DrawingUploader", fields: [uploadedById], references: [id])
  checklistFills ChecklistSubmission[]
  markupPages    DrawingRevisionMarkupPage[]
}

/// Annotated PDF pages — full history per page (latest shown first in UI)
model DrawingRevisionMarkupPage {
  id           String   @id @default(cuid())
  revisionId   String
  pageNumber   Int
  fileUrl      String
  fileName     String?
  uploadedById String?
  createdAt    DateTime @default(now())

  revision   DrawingRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  uploadedBy User?           @relation("DrawingMarkupUploader", fields: [uploadedById], references: [id])

  @@index([revisionId, pageNumber, createdAt])
}

model ChecklistTemplate {
  id               String   @id @default(cuid())
  name             String
  category         String
  /// DrawingCheck | SiteExecution | QualityInspection | Safety
  checklistType    String   @default("SiteExecution")
  source           String?
  /// QA / fill instructions shown on the form
  instructions     String?
  /// Minimum photos required on submit (Quality/Safety typically 3)
  requirePhotosMin Int      @default(0)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt

  items       ChecklistItem[]
  assignments ChecklistAssignment[]
}

model ChecklistItem {
  id           String  @id @default(cuid())
  templateId   String
  itemCode     String?
  description  String
  /// Per-line quality / safety instruction
  instruction  String?
  sortOrder    Int     @default(0)
  section      String?
  requirePhoto Boolean @default(false)

  template ChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
}

model ChecklistAssignment {
  id         String   @id @default(cuid())
  projectId  String
  templateId String
  status     String   @default("Assigned")
  assignedAt DateTime @default(now())

  project     Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  template    ChecklistTemplate     @relation(fields: [templateId], references: [id], onDelete: Cascade)
  submissions ChecklistSubmission[]

  @@unique([projectId, templateId])
}

model ChecklistSubmission {
  id             String    @id @default(cuid())
  assignmentId   String
  drawingId      String?
  revisionId     String?
  revisionNumber String?
  submittedById  String
  status         String    @default("Draft")
  responsesJson  String    @db.Text
  remarks        String?
  /// Fill | PreUploadDrawing
  purpose        String    @default("Fill")
  /// One-time token consumed when drawing/revision upload succeeds
  unlockToken    String?   @unique
  unlockUsedAt   DateTime?
  reviewedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  assignment  ChecklistAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  drawing     Drawing?            @relation(fields: [drawingId], references: [id])
  revision    DrawingRevision?    @relation(fields: [revisionId], references: [id])
  submittedBy User                @relation(fields: [submittedById], references: [id])
  photos      ChecklistPhoto[]
}

model ChecklistPhoto {
  id           String   @id @default(cuid())
  submissionId String
  /// Checklist template item this evidence belongs to (null = whole submission)
  itemId       String?
  /// photo | doc
  kind         String   @default("photo")
  fileUrl      String
  caption      String?
  comment      String?
  createdAt    DateTime @default(now())

  submission ChecklistSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
}

model DailyLog {
  id               String    @id @default(cuid())
  projectId        String
  logDate          DateTime
  weatherCondition String?
  weatherSource    String?
  status           String    @default("Open")
  createdById      String
  completedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  project   Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User                @relation("DailyLogCreator", fields: [createdById], references: [id])
  manpower  DailyLogManpower[]
  equipment DailyLogEquipment[]
  notes     DailyLogNote[]
  photos    DailyLogPhoto[]

  @@unique([projectId, logDate])
}

model DailyLogManpower {
  id          String  @id @default(cuid())
  dailyLogId  String
  companyName String
  workerCount Int
  hoursWorked Float   @default(8)
  comments    String?

  dailyLog DailyLog @relation(fields: [dailyLogId], references: [id], onDelete: Cascade)
}

model DailyLogEquipment {
  id            String  @id @default(cuid())
  dailyLogId    String
  companyName   String
  equipmentType String
  hoursUsed     Float?
  comments      String?

  dailyLog DailyLog @relation(fields: [dailyLogId], references: [id], onDelete: Cascade)
}

model DailyLogNote {
  id         String   @id @default(cuid())
  dailyLogId String
  noteText   String
  createdAt  DateTime @default(now())

  dailyLog DailyLog @relation(fields: [dailyLogId], references: [id], onDelete: Cascade)
}

model DailyLogPhoto {
  id         String   @id @default(cuid())
  dailyLogId String
  fileUrl    String
  caption    String?
  createdAt  DateTime @default(now())

  dailyLog DailyLog @relation(fields: [dailyLogId], references: [id], onDelete: Cascade)
}

model CommunicationMatrix {
  id                String   @id @default(cuid())
  projectId         String
  communicationType String
  fromRole          String
  toRole            String
  frequency         String
  channel           String   @default("Email")
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

/**
 * BPCL-style contact matrix (TECHNICAL / COMMERCIAL) — Name, Designation, Company, SPOC, Mobile, Email, TO/CC
 */
model CommunicationContact {
  id              String   @id @default(cuid())
  projectId       String
  /// TECHNICAL | COMMERCIAL
  matrixKind      String   @default("TECHNICAL")
  /// Client | PMC | Consultant | Contractor | Other
  orgSection      String
  orgName         String
  /// true = section header row (org name only)
  isSectionHeader Boolean  @default(false)
  sortOrder       Int      @default(0)
  personName      String?
  designation     String?
  company         String?
  spoc            String?
  mobile          String?
  email           String?
  /// TO | CC
  mailRole        String?
  officeAddress   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, matrixKind])
}

model CommunicationLog {
  id        String   @id @default(cuid())
  projectId String
  subject   String
  body      String?
  fromUser  String?
  toRoles   String
  channel   String   @default("In-App")
  sentAt    DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Meeting {
  id              String   @id @default(cuid())
  projectId       String
  title           String
  meetingDate     DateTime
  location        String?
  /// Agenda → MoM → Follow-up → Closed (client video flow)
  status          String   @default("Agenda")
  /// Optional link to parent MoM when this is a follow-up
  parentMeetingId String?
  agendaNotes     String?
  durationMins    Int      @default(60)
  /// Microsoft Teams join URL (Graph onlineMeeting or calendar event)
  teamsJoinUrl    String?
  /// Graph calendar event id or onlineMeeting id
  graphEventId    String?
  calendarWebLink String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  project Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  items   MeetingItem[]
}

model MeetingItem {
  id               String    @id @default(cuid())
  meetingId        String
  /// Agenda | MoM | Action | Follow-up
  category         String    @default("Agenda")
  description      String
  assignedToId     String?
  dueDate          DateTime?
  priority         String    @default("Medium")
  resolutionStatus String    @default("Open")
  carriedOverFrom  String?

  meeting    Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  assignedTo User?   @relation(fields: [assignedToId], references: [id])
}

/// COP / RA bill tracker — vendor bill entries (client video)
model VendorBill {
  id            String   @id @default(cuid())
  projectId     String
  vendorId      String?
  vendorName    String
  billNo        String
  billDate      DateTime @default(now())
  amount        Float    @default(0)
  gstAmount     Float    @default(0)
  /// Draft | Submitted | Under review | Certified | Paid | Rejected
  status        String   @default("Draft")
  copNo         String?
  description   String?
  attachmentUrl String?
  createdById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  vendor  Vendor? @relation(fields: [vendorId], references: [id])
}

model CostBudgetLine {
  id                String   @id @default(cuid())
  projectId         String
  srNo              String?
  description       String
  stakeholder       String?
  budgetedAmount    Float    @default(0)
  workOrderAmount   Float    @default(0)
  certifiedAmount   Float    @default(0)
  /// Forecast Addition (Based on GFC)
  forecastedAmount  Float    @default(0)
  /// Forecast Reduction
  forecastReduction Float    @default(0)
  nonTendered       Float    @default(0)
  /// Basic Rate Difference (BRD) — Steel / Cement / Tiles
  steelExcess       Float    @default(0)
  steelSaving       Float    @default(0)
  cementExcess      Float    @default(0)
  cementSaving      Float    @default(0)
  tilesExcess       Float    @default(0)
  tilesSaving       Float    @default(0)
  /// Gross Total Amount (Projected)
  grossTotal        Float    @default(0)
  remarks           String?  @db.Text
  createdAt         DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model CostMonitoringLine {
  id                   String   @id @default(cuid())
  projectId            String
  packageName          String   @default("Civil")
  /// BOQ section heading (e.g. SECTION A — EARTH WORK)
  section              String?
  itemNo               String?
  description          String
  uom                  String?
  rate                 Float    @default(0)
  boqQty               Float    @default(0)
  extraQty             Float    @default(0)
  gfcQty               Float    @default(0)
  achievedQty          Float    @default(0)
  certifiedQty         Float    @default(0)
  excessQty            Float    @default(0)
  savingQty            Float    @default(0)
  boqCost              Float    @default(0)
  /// SPDC Monitoring Combined cols 12–38 (costs, progress, EV, CPI, ETC/EAC/VAC)
  extraItemCost        Float    @default(0)
  gfcCost              Float    @default(0)
  achievedCost         Float    @default(0)
  excessCost           Float    @default(0)
  savingCost           Float    @default(0)
  certifiedInvoiceCost Float    @default(0)
  pctBoq               Float    @default(0)
  pctGfc               Float    @default(0)
  pctAchieved          Float    @default(0)
  pctCertified         Float    @default(0)
  evBoq                Float    @default(0)
  evGfc                Float    @default(0)
  evCertified          Float    @default(0)
  actualCost           Float    @default(0)
  cpi                  Float    @default(0)
  cpiStatus            String?
  etcBoq               Float    @default(0)
  etcGfc               Float    @default(0)
  etcCertified         Float    @default(0)
  eac                  Float    @default(0)
  vac                  Float    @default(0)
  varBoqGfc            Float    @default(0)
  varGfcAchieved       Float    @default(0)
  varGfcCertified      Float    @default(0)
  overrunBoq           Float    @default(0)
  overrunGfc           Float    @default(0)
  overrunCertified     Float    @default(0)
  createdAt            DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

/**
 * Measurement book line (from SPDC Budget * MB sheets)
 */
model CostMbLine {
  id          String   @id @default(cuid())
  projectId   String
  packageName String   @default("Civil")
  srNo        String?
  description String
  nos1        Float    @default(0)
  nos2        Float    @default(0)
  length      Float    @default(0)
  width       Float    @default(0)
  height      Float    @default(0)
  qty         Float    @default(0)
  unit        String?
  raBill      String?
  remark      String?
  /// Links to CostMonitoringLine.itemNo for achieved qty rollup
  itemCode    String?
  /// SPDC sheet row order — preserves Excel band › entry sequence
  lineIndex   Int      @default(0)
  /// item | description | subsection | subitem | data | total | note
  rowKind     String   @default("data")
  createdAt   DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

/**
 * Bar bending schedule line (from * BBS sheets)
 */
model CostBbsLine {
  id               String   @id @default(cuid())
  projectId        String
  packageName      String   @default("Civil")
  barMark          String?
  /// Bend shape code — links to global BbsShapeMaster
  shapeCode        String?
  /// Optional BOQ item code for monitoring rollup
  itemCode         String?
  /// Section header mark from BBS sheet (A, 1, FOOTING, etc.)
  sectionMark      String?
  diameterMm       Float    @default(0)
  shape            String?
  lengthMm         Float    @default(0)
  nos              Float    @default(0)
  nosPerMember     Float    @default(0)
  nosOfMember      Float    @default(0)
  shapeLenA        Float    @default(0)
  shapeLenB        Float    @default(0)
  shapeLenC        Float    @default(0)
  shapeLenD        Float    @default(0)
  shapeLenE        Float    @default(0)
  totalLength      Float    @default(0)
  weightKg         Float    @default(0)
  location         String?
  /// Annotated bend diagram (PDF/PNG) for this bar mark — SharePoint path
  shapeDiagramPath String?
  shapeDiagramUrl  String?
  /// SPDC sheet row order
  lineIndex        Int      @default(0)
  /// section | subsection | subheader | data | note
  rowKind          String   @default("data")
  createdAt        DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

/**
 * Global BBS bend shape library — code + diagram maintained in Master setup.
 */
/**
 * Site / Final Drawing Index master — global drawing index template rows.
 * Each row is a planned drawing (Sr No · Drawing No · Title · Discipline ·
 * Stage: Concept / Design / GFC / As-built · Status · Notes).  Reused across
 * projects: PMC picks the relevant subset per project so nothing gets missed.
 */
model SiteFinalIndex {
  id          String   @id @default(cuid())
  srNo        Int      @default(0)
  drawingNo   String
  title       String
  discipline  String   @default("Architectural")
  stage       String   @default("Design")
  status      String   @default("Planned")
  packageHint String?
  notes       String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([drawingNo])
}

model BbsShapeMaster {
  id          String   @id @default(cuid())
  shapeCode   String   @unique
  name        String?
  description String?
  bendInfo    String?
  packageHint String?
  diagramPath String?
  diagramUrl  String?
  /// Comma-separated parameter labels used by the shape (e.g. "A,B,C,D").
  /// BBS rows can then capture numeric values for each label.
  parameters  String?
  /// Cutting length formula in the parameter labels (e.g. "A+B+C+D" or
  /// "A+B+2R-2D" where R = bend radius, D = bar diameter). Kept as a
  /// display string; the BBS row keeps the actual calculated length.
  cutFormula  String?
  /// Master reference (IS-2502 clause, BS-8666 shape code, etc.).
  standardRef String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CostCashflowPeriod {
  id            String    @id @default(cuid())
  projectId     String
  periodLabel   String
  periodDate    DateTime?
  packageName   String
  plannedAmount Float     @default(0)
  actualAmount  Float     @default(0)
  progressPct   Float     @default(0)
  createdAt     DateTime  @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model CostRateDifference {
