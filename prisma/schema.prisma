/** Vendor BOQ upload — one slot per vendor × discipline (R2 pattern). */
model CrmVendorBoq {
  id           String   @id @default(cuid())
  bidPackageId String
  vendorId     String?
  vendorLabel  String
  discipline   String
  fileName     String?
  storagePath  String?
