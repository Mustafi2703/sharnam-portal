# Hostinger → Settings & Redeploy → Environment variables → Import .env
# Copy to hostinger-env-import.env, fill secrets, then upload in hPanel.
# Format: KEY=value (one per line). Comments (#) are ignored.

NODE_ENV=production
JWT_SECRET=CHANGE-ME-openssl-rand-base64-48
WEB_ORIGIN=https://portal.spdc.in
UPLOAD_DIR=./data/uploads

MYSQL_USER=YOUR_MYSQL_USER_FROM_HPANEL
MYSQL_PASSWORD=YOUR_MYSQL_PASSWORD_FROM_HPANEL
MYSQL_DATABASE=YOUR_MYSQL_DATABASE_FROM_HPANEL
MYSQL_HOST=127.0.0.1

SKIP_BUILD_SEED=1
SEED_PASSWORD=Demo@1234
SHARNAM_EXCEL_ROOT=./seed/data

MOCK_ONEDRIVE=false
AZURE_TENANT_ID=YOUR_ENTRA_TENANT_ID
AZURE_CLIENT_ID=YOUR_AZURE_APP_CLIENT_ID
AZURE_CLIENT_SECRET=YOUR_AZURE_CLIENT_SECRET
SHAREPOINT_SITE_URL=https://spdcsmb.sharepoint.com/sites/SharnamProjects

GRAPH_MAIL_FROM=pmc-portal@spdc.in
GRAPH_MAIL_ENABLED=true
PORTAL_MAIL_LIVE=false

# DO NOT include these in import:
# RUN_SEED=1
# DATABASE_URL=file:./data/prod.db
# PORT=
