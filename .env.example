# Copy to .env on every machine:  cp .env.example .env
# Never commit .env (secrets / machine-local paths).

# Production: MySQL (Hostinger hPanel → Databases). Local: Docker MySQL or Hostinger remote.
# DATABASE_URL=mysql://USER:PASSWORD@localhost:3306/DATABASE
# Local SQLite is no longer supported — schema uses MySQL.
DATABASE_URL=mysql://root:password@localhost:3306/sharnam_dev
JWT_SECRET=change-me
PORT=4000
UPLOAD_DIR=./uploads
WEB_ORIGIN=http://localhost:5173
SEED_PASSWORD=Demo@1234

# Optional: folder with client Excel templates (defaults to repo root)
# SHARNAM_EXCEL_ROOT=.

# --- Microsoft 365 (leave mocks until client sends Entra creds) ---
MOCK_ONEDRIVE=true
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# SHAREPOINT_SITE_URL=https://contoso.sharepoint.com/sites/SharnamProjects
# Aliases also accepted: GRAPH_TENANT_ID / GRAPH_CLIENT_ID / GRAPH_CLIENT_SECRET

# Outlook mail (shared mailbox)
# GRAPH_MAIL_FROM=pmc-portal@contoso.com
# GRAPH_MAIL_ENABLED=false

# MS Project S-curve (only if Project / Project Online licensed — SPDC: not licensed)
# MS_PROJECT_ENABLED=false
# MS_PROJECT_MODE=project_for_web
# MS_PROJECT_PWA_URL=
# MS_PROJECT_DEFAULT_PROJECT_ID=

